set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(sdk "$ENV{V32_ARM_TOOLCHAIN_ROOT}")
if(EXISTS "${sdk}/bin/arm-buildroot-linux-gnueabihf-gcc")
    set(triple arm-buildroot-linux-gnueabihf)
    set(sysroot "${sdk}/${triple}/sysroot")
elseif(EXISTS "${sdk}/bin/arm-none-linux-gnueabihf-gcc")
    set(triple arm-none-linux-gnueabihf)
    set(sysroot "${sdk}/${triple}/libc")
else()
    message(FATAL_ERROR "Set V32_ARM_TOOLCHAIN_ROOT to a compatible ARM GNU toolchain root")
endif()
set(CMAKE_C_COMPILER "${sdk}/bin/${triple}-gcc")
set(CMAKE_CXX_COMPILER "${sdk}/bin/${triple}-g++")
set(CMAKE_STRIP "${sdk}/bin/${triple}-strip")
set(CMAKE_SYSROOT "${sysroot}")
set(CMAKE_FIND_ROOT_PATH "${sysroot}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(arch "-march=armv7-a -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard")
set(CMAKE_C_FLAGS_INIT "${arch} -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "${arch} -ffunction-sections -fdata-sections")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${arch} -static -Wl,--gc-sections")
